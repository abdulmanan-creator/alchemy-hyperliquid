{
  "name": "@alchemy-hl/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@alchemy-hl/shared": "*",
    "@msgpack/msgpack": "^3.0.0-beta.2",
    "viem": "^2.21.6"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "description": "Zero-custody TypeScript SDK for trading on Hyperliquid through Alchemy's builder API \u2014 local signing, market/limit/TP-SL orders, positions, agent mode.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulmanan-creator/alchemy-hyperliquid.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "hyperliquid",
    "trading",
    "perps",
    "alchemy",
    "builder-code",
    "defi",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}