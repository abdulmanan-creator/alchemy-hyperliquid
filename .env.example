# =============================================================================
# Alchemy Hyperliquid — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Both apps read from the repo-root .env via dotenv when running locally.

# ---- API (apps/api) ---------------------------------------------------------

# Alchemy's builder wallet address (the one users approve a fee to). 0x-prefixed.
# This wallet must be funded with >= 100 USDC in perps on Hyperliquid mainnet
# and run in standard (non-account-abstraction) mode.
ALCHEMY_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000

# Hyperliquid REST base URL.
#   mainnet:  https://api.hyperliquid.xyz
#   testnet:  https://api.hyperliquid-testnet.xyz
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# Builder fees in basis points (1 bps = 0.01%).
# Defaults: perps = 4 (0.04%), spot = 5 (0.05%).
PERPS_BUILDER_FEE_BPS=4
SPOT_BUILDER_FEE_BPS=5

# Hyperliquid protocol-enforced maximums. Do not raise above these.
MAX_BUILDER_FEE_BPS_PERPS=10
MAX_BUILDER_FEE_BPS_SPOT=100

# API server port.
PORT=8080

# Allowed CORS origin for the web app. Comma-separated for multiple.
WEB_ORIGIN=http://localhost:3000

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Web (apps/web) ---------------------------------------------------------

# Where the web app should send API requests.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public-readable copy of the builder address (shown in the UI).
NEXT_PUBLIC_BUILDER_ADDR=0x0000000000000000000000000000000000000000

# Privy app ID (client). Get one at https://dashboard.privy.io.
# Privy handles email/Google login + embedded Arbitrum wallet creation, with
# external wallets (MetaMask, Coinbase, Phantom, WalletConnect) available in
# the same modal.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app secret (server-side). Used to verify Privy-issued JWTs when we
# start gating API endpoints on Privy sessions. Not wired yet — see
# TODO(privy-jwt) in apps/api.
PRIVY_APP_SECRET=

# Internal-only feature flag: when "true", /approve renders a "Place test
# trade" card in the approved state. Used for smoke-testing the fee-earning
# loop on mainnet from inside our app. NOT product surface — the product is
# the API for agents; this is dev scaffolding. Always leave false in
# production deploys.
NEXT_PUBLIC_ENABLE_TEST_TRADE=false
